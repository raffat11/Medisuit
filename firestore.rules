
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read access to the list of authorized users for registration purposes.
    // This is secure because this collection should only contain non-sensitive data (emails).
    match /authorizedUsers/{userId} {
      allow read: if true;
      allow write: if request.auth != null; // Only authenticated users can (potentially) write.
    }

    // Secure all other collections by default.
    // Requires the user to be authenticated to read or write any other data.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
